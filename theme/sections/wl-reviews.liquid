{%- doc -%}
  "The reviews we're working to earn" — honest-new-brand pattern, three aspirational cards.
{%- enddoc -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="wl-wrap">
    <p class="wl-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="wl-h2">{{ section.settings.heading }} <span class="wl-k">{{ section.settings.heading_accent }}</span></h2>
    <div class="wl-reviews">
      {%- for i in (1..3) -%}
        {%- assign qk = 'quote' | append: i -%}{%- assign lk = 'label' | append: i -%}
        {%- if section.settings[qk] != blank -%}
          <div class="wl-rev"><p>&ldquo;{{ section.settings[qk] }}&rdquo;</p><span>{{ section.settings[lk] }}</span></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .wl-reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 26px; }
  .wl-rev { background: var(--wl-paper); border: 2px solid var(--wl-ink); border-radius: 18px; padding: 22px 24px; }
  .wl-rev p { font-family: 'Young Serif', Georgia, serif; font-size: 18px; line-height: 1.4; margin: 0; }
  .wl-rev span { display: block; margin-top: 12px; font-size: 14.5px; font-weight: 700; color: #6f5c50; }
{% endstylesheet %}

{% schema %}
{
  "name": "wetlipps · Reviews we’re earning",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The reviews we’re working to earn" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We’re new. Hold us" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "to these." },
    { "type": "textarea", "id": "quote1", "label": "Card 1", "default": "First balm that actually worked on my lips — I know, because I’m married to the woman who tested all the others." },
    { "type": "text", "id": "label1", "label": "Card 1 label", "default": "The review we’re working for" },
    { "type": "textarea", "id": "quote2", "label": "Card 2", "default": "Ordered a date-night surprise for our anniversary. Plain box, nothing on the outside — which was exactly the point." },
    { "type": "text", "id": "label2", "label": "Card 2 label", "default": "The review we want from your husband" },
    { "type": "textarea", "id": "quote3", "label": "Card 3", "default": "Finally — a brand in this aisle that feels like it was made for married people, run by people who actually like each other." },
    { "type": "text", "id": "label3", "label": "Card 3 label", "default": "The review that would mean the most" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "wetlipps · Reviews we’re earning", "category": "wetlipps" }]
}
{% endschema %}

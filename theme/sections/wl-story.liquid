{%- doc -%}
  Our Story page: hero + family photo, ABT origin cards, belief band, house rules, fund band, sign-off.
{%- enddoc -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="wl-wrap wl-story">
    <header class="wl-story__hero">
      <p class="wl-eyebrow">Our story</p>
      <h1 class="wl-h1 wl-story__h1">{{ section.settings.h1 }} <span class="wl-story__h1b">{{ section.settings.h1b }}</span></h1>
      <p class="wl-story__sub">{{ section.settings.sub }}</p>
      {%- if section.settings.hero_image != blank -%}
        {%- assign fam_alt = section.settings.hero_image.alt | default: 'The six of us at the beach, golden hour' -%}
        {{ section.settings.hero_image | image_url: width: 1720 | image_tag: widths: '860, 1720', sizes: '(min-width: 900px) 860px, 100vw', alt: fam_alt, class: 'wl-story__photo' }}
      {%- else -%}
        <img class="wl-story__photo" src="{{ 'wl-family.jpg' | asset_url }}" alt="The six of us at the beach, golden hour" width="1600" height="900">
      {%- endif -%}
    </header>

    <section class="wl-story__block">
      <p class="wl-eyebrow">How it started</p>
      <h2 class="wl-h2">It started <span class="wl-k">on a hike.</span></h2>
      <div class="wl-abt">
        <div><b>AND</b><p>{{ section.settings.abt_and }}</p></div>
        <div><b>BUT</b><p>{{ section.settings.abt_but }}</p></div>
        <div><b>THEREFORE</b><p>{{ section.settings.abt_therefore }}</p></div>
      </div>
    </section>

    <section class="wl-story__block">
      <div class="wl-band wl-story__band">
        <div class="wl-band__img">
          {%- if section.settings.believe_image != blank -%}
            {%- assign bel_alt = section.settings.believe_image.alt | default: 'A kiss on the cheek at golden hour' -%}
            {{ section.settings.believe_image | image_url: width: 1000 | image_tag: widths: '500, 1000', sizes: '(min-width: 861px) 40vw, 100vw', alt: bel_alt, loading: 'lazy' }}
          {%- else -%}
            <img src="{{ 'wl-believe.jpg' | asset_url }}" alt="A kiss on the cheek at golden hour" loading="lazy">
          {%- endif -%}
        </div>
        <div>
          <p class="wl-eyebrow">What we believe</p>
          <h2 class="wl-h2">Fifteen years in, <span class="wl-k">still flirting.</span></h2>
          <p class="wl-p">{{ section.settings.believe_p1 }}</p>
          <p class="wl-p">{{ section.settings.believe_p2 }}</p>
        </div>
      </div>
    </section>

    <section class="wl-story__block">
      <p class="wl-eyebrow">The house rules</p>
      <h2 class="wl-h2">Read our <span class="wl-k">Lipps.</span></h2>
      <div class="wl-vals">
        <div class="wl-val"><b>Connection first</b><p>{{ section.settings.rule1 }}</p></div>
        <div class="wl-val"><b>Authenticity you can eat</b><p>{{ section.settings.rule2 }}</p></div>
        <div class="wl-val"><b>Generosity built in</b><p>{{ section.settings.rule3 }}</p></div>
      </div>
    </section>

    <section class="wl-story__block">
      <div class="wl-fund" id="fund">
        <p class="wl-eyebrow wl-fund__eyebrow">The Restoration Fund</p>
        <h2 class="wl-h2 wl-fund__h2">Restoration is possible.</h2>
        <p class="wl-fund__p">{{ section.settings.fund_p }}</p>
        <span class="wl-fund__pill">10% of profits &middot; every order &middot; always</span>
      </div>
    </section>

    <section class="wl-story__close">
      <p class="wl-story__sig">&ldquo;{{ section.settings.signoff }}&rdquo;</p>
      <p class="wl-story__by">&mdash; the Lipps</p>
      <a class="wl-cta" href="{{ routes.root_url }}#shop">Shop the shelf</a>
    </section>
  </div>
</div>

{% stylesheet %}
  .wl-story__hero { text-align: center; padding: clamp(30px, 5vw, 64px) 0 0; }
  .wl-story__h1 { font-size: clamp(38px, 6vw, 72px); color: var(--wl-kiss); max-width: 18ch; margin: 0 auto; }
  .wl-story__h1b { color: var(--wl-ink); }
  .wl-story__sub { margin: 14px auto 0; font-size: 19px; color: var(--wl-muted); max-width: 52ch; }
  .wl-story__photo { width: 100%; max-width: 860px; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 22px; display: block; margin: 36px auto 0; height: auto; }
  .wl-story__block { padding-top: clamp(44px, 5.5vw, 76px); }
  .wl-abt { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-top: 30px; }
  .wl-abt > div { background: var(--wl-paper); border: 2px solid var(--wl-ink); border-top: 5px solid var(--wl-kiss); border-radius: 14px; padding: 20px 22px; }
  .wl-abt b { font-family: 'Young Serif', Georgia, serif; font-weight: 400; color: var(--wl-kiss); display: block; font-size: 19px; margin-bottom: 6px; }
  .wl-abt p { font-size: 16px; margin: 0; }
  .wl-story__band { grid-template-columns: .85fr 1.15fr; gap: clamp(28px, 5vw, 60px); padding: clamp(24px, 4vw, 48px); }
  .wl-story__band .wl-band__img img { aspect-ratio: auto; height: auto; }
  .wl-vals { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 28px; }
  .wl-val { background: var(--wl-paper); border: 2px solid var(--wl-ink); border-radius: 18px; padding: 24px 26px; }
  .wl-val b { font-family: 'Young Serif', Georgia, serif; font-weight: 400; font-size: 20px; color: var(--wl-kiss); display: block; margin-bottom: 8px; }
  .wl-val p { font-size: 16px; margin: 0; }
  .wl-fund { background: var(--wl-kiss); color: var(--wl-cream); border-radius: 22px; padding: clamp(30px, 4.5vw, 54px); text-align: center; }
  .wl-fund__eyebrow { color: var(--wl-blush); }
  .wl-fund__h2 { color: var(--wl-cream); }
  .wl-fund__p { margin: 10px auto 0; max-width: 62ch; font-size: 18px; color: var(--wl-cream); }
  .wl-fund__pill { display: inline-block; margin-top: 22px; border: 1.5px solid rgba(248,241,230,.6); border-radius: 999px; padding: 11px 24px; font-weight: 800; letter-spacing: .06em; font-size: 16px; }
  .wl-story__close { text-align: center; padding: clamp(36px, 5vw, 64px) 0 clamp(30px, 4vw, 50px); }
  .wl-story__sig { font-family: 'Young Serif', Georgia, serif; font-size: clamp(22px, 3vw, 30px); color: var(--wl-kiss); margin: 0; }
  .wl-story__by { margin: 10px 0 26px; color: var(--wl-muted); }
  @media (max-width: 860px) { .wl-abt, .wl-story__band { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "lovethelipps · Our Story",
  "settings": [
    { "type": "text", "id": "h1", "label": "Headline", "default": "We’re the Lipps." },
    { "type": "text", "id": "h1b", "label": "Headline, second half", "default": "Yes, really." },
    { "type": "textarea", "id": "sub", "label": "Subline", "default": "A married couple, four kids — and the lip care company that was hiding in our last name the whole time." },
    { "type": "image_picker", "id": "hero_image", "label": "Family photo (defaults to the beach photo)" },
    { "type": "textarea", "id": "abt_and", "label": "AND card", "default": "On a hike, one of us was battling chapped lips — again. Then it clicked: we’re the Lipps family. We should have wet lips, not dry ones." },
    { "type": "textarea", "id": "abt_but", "label": "BUT card", "default": "But why stop at one balm? A family named Lipps could help with every kind of kiss." },
    { "type": "textarea", "id": "abt_therefore", "label": "THEREFORE card", "default": "So we hunted down what actually works and put our name on it: honest lip care for every day, starting with Wetlipps." },
    { "type": "image_picker", "id": "believe_image", "label": "Belief-band photo (defaults to the cheek-kiss photo)" },
    { "type": "textarea", "id": "believe_p1", "label": "Belief paragraph 1", "default": "We don’t think family values and attraction are opposites — we think they’re roommates. Our shelf is built for both: the daily kiss and the unhurried moment." },
    { "type": "textarea", "id": "believe_p2", "label": "Belief paragraph 2", "default": "Everything with our name on it celebrates connection inside committed love." },
    { "type": "textarea", "id": "rule1", "label": "Rule 1", "default": "We exist to help people stay close — to their person, their family, their promises. If a product doesn’t serve that, we don’t sell it." },
    { "type": "textarea", "id": "rule2", "label": "Rule 2", "default": "Every ingredient on every label in plain type. If we wouldn’t let our kids eat it, it doesn’t touch your lips." },
    { "type": "textarea", "id": "rule3", "label": "Rule 3", "default": "Ten percent of profits goes to restoration — not when we’re big, not someday. From the first tube." },
    { "type": "textarea", "id": "fund_p", "label": "Fund paragraph", "default": "We celebrate healthy love. And we know the world needs restoration. So ten percent of our profits — tracked openly, printed on every pack, always — will fund organizations that help people find restoration." },
    { "type": "text", "id": "signoff", "label": "Sign-off quote", "default": "This company is our date hike that got out of hand." },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "lovethelipps · Our Story", "category": "lovethelipps" }]
}
{% endschema %}

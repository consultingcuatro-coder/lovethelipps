{%- doc -%}
  Trust chips: centered under the hero, the rule beneath them is the break into the shelf.
{%- enddoc -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="wl-wrap wl-usp">
    {%- for i in (1..4) -%}
      {%- assign tkey = 'chip' | append: i -%}
      {%- assign lkey = 'link' | append: i -%}
      {%- assign text = section.settings[tkey] -%}
      {%- if text != blank -%}
        {%- assign href = section.settings[lkey] -%}
        {%- if href != blank -%}<a href="{{ href }}">{{ text }}</a>{%- else -%}<span>{{ text }}</span>{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .wl-usp { display: flex; justify-content: center; gap: 14px; flex-wrap: wrap; padding: 0 0 26px; border-bottom: 2px solid var(--wl-rule); }
  .wl-usp > * { background: var(--wl-paper); border: 1.5px solid rgba(122,37,48,.2); border-radius: 999px; padding: 9px 20px; font-size: 15px; font-weight: 600; color: var(--wl-ink); text-decoration: none; text-decoration-color: transparent; }
  .wl-usp > a:hover { text-decoration: underline; text-decoration-color: currentColor; }
  @media (max-width: 1140px) { .wl-usp { display: grid; grid-template-columns: repeat(2, max-content); justify-content: center; gap: 12px 14px; } }
  @media (max-width: 480px) { .wl-usp { grid-template-columns: 1fr 1fr; } .wl-usp > * { text-align: center; padding: 9px 14px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "wetlipps · Trust chips",
  "settings": [
    { "type": "text", "id": "chip1", "label": "Chip 1", "default": "🌿 Organic & vegan" },
    { "type": "url", "id": "link1", "label": "Chip 1 link" },
    { "type": "text", "id": "chip2", "label": "Chip 2", "default": "👨‍👩‍👧‍👦 Family-run in Santa Barbara" },
    { "type": "url", "id": "link2", "label": "Chip 2 link" },
    { "type": "text", "id": "chip3", "label": "Chip 3", "default": "🥄 Safe enough to eat" },
    { "type": "url", "id": "link3", "label": "Chip 3 link" },
    { "type": "text", "id": "chip4", "label": "Chip 4", "default": "💗 10% · The Restoration Fund" },
    { "type": "url", "id": "link4", "label": "Chip 4 link" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "wetlipps · Trust chips", "category": "wetlipps" }]
}
{% endschema %}

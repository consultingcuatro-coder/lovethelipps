4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"/></svg><span class="visually-hidden">Instagram</span></a></li>{%- endif -%}
          {%- if section.settings.facebook_url != blank -%}<li><a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg><span class="visually-hidden">Facebook</span></a></li>{%- endif -%}
          {%- if section.settings.youtube_url != blank -%}<li><a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg><span class="visually-hidden">YouTube</span></a></li>{%- endif -%}
          {%- if section.settings.x_url != blank -%}<li><a href="{{ section.settings.x_url }}" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg><span class="visually-hidden">X</span></a></li>{%- endif -%}
        </ul>
      </div>
      {%- endif -%}
    </nav>
    <div class="wl-footer__bottom">
      <p class="wl-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | downcase }} &middot; {{ section.settings.location }} &middot; All rights reserved.</p>
      <p class="wl-footer__lockup">{{ section.settings.lockup }}</p>
    </div>
  </div>
</div>

{% stylesheet %}
  .wl-footer { background: var(--wl-black); color: #d9cfc2; padding: 56px clamp(20px, 4vw, 52px) 28px; font-size: 18px; line-height: 1.5; }
  .wl-footer ul { list-style: none; margin: 0; padding: 0; }
  .wl-footer__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 40px 48px; }
  .wl-footer__h { font-family: 'Young Serif', Georgia, serif; font-weight: 400; font-size: 22px; line-height: 1.2; color: var(--wl-gold); margin: 0 0 10px; }
  .wl-footer__cols li + li { margin-top: 8px; }
  .wl-footer a { color: #d9cfc2; text-decoration: none; text-decoration-color: transparent; }
  .wl-footer a:hover, .wl-footer a:focus-visible { color: var(--wl-gold); }
  .wl-footer__social { display: flex; flex-wrap: wrap; gap: 8px; }
  .wl-footer__social a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 1.5px solid rgba(217,207,194,.35); border-radius: 50%; }
  .wl-footer__social a:hover { border-color: var(--wl-gold); }
  .wl-footer__bottom { margin-top: 40px; padding-top: 24px; border-top: 1px solid rgba(217,207,194,.14); }
  .wl-footer__copy { margin: 0; font-size: 15px; color: #a89f93; }
  .wl-footer__lockup { margin: 10px 0 0; font-family: 'Young Serif', Georgia, serif; font-size: 16px; color: var(--wl-gold); }
  @media (max-width: 860px) { .wl-footer__cols { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .wl-footer__cols { grid-template-columns: 1fr; gap: 30px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "lovethelipps footer",
  "settings": [
    { "type": "collection", "id": "shelf_collection", "label": "Products to list (collection)" },
    { "type": "text", "id": "follow_heading", "label": "Follow heading", "default": "Follow us" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "url", "id": "x_url", "label": "X URL" },
    { "type": "text", "id": "location", "label": "Location line", "default": "Santa Barbara, California" },
    { "type": "text", "id": "lockup", "label": "Lockup", "default": "Made for Lipps. All of them ;)" }
  ],
  "enabled_on": { "groups": ["footer"] },
  "presets": []
}
{% endschema %}

{%- doc -%}
  lovethelipps footer: shop / house / help columns, an optional Follow-us row (icons render only
  when a URL is set — nothing fabricated), copyright + policy links + the lockup.
{%- enddoc -%}
{%- assign col = collections[section.settings.shelf_collection] | default: collections['the-shelf'] -%}
<div class="wl-footer">
  <div class="wl-wrap">
    <nav class="wl-footer__cols" aria-label="Footer">
      <div>
        <h2 class="wl-footer__h">{{ shop.name | downcase }}</h2>
        <ul>
          <li><a href="{{ routes.root_url }}#shop">Shop the shelf</a></li>
          {%- for product in col.products limit: 6 -%}<li><a href="{{ product.url }}">{{ product.title }}</a></li>{%- endfor -%}
        </ul>
      </div>
      <div>
        <h2 class="wl-footer__h">Help</h2>
        <ul>
          {%- for policy in shop.policies -%}{%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
      {%- assign socials = 'instagram,facebook,youtube,x' | split: ',' -%}
      {%- assign any_social = false -%}
      {%- for s in socials -%}{%- assign key = s | append: '_url' -%}{%- if section.settings[key] != blank -%}{%- assign any_social = true -%}{%- endif -%}{%- endfor -%}
      {%- if any_social -%}
      <div class="wl-footer__follow">
        <h2 class="wl-footer__h">{{ section.settings.follow_heading }}</h2>
        <ul class="wl-footer__social">

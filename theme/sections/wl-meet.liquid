{%- doc -%}
  Meet the Lipps band: couple photo + origin paragraph + chips + link to the story page.
{%- enddoc -%}
<div class="section-background"></div>
<div class="section section--page-width spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="wl-wrap">
    <div class="wl-band wl-meet-band">
      <div class="wl-band__img">
        {%- if section.settings.image != blank -%}
          {%- assign meet_alt = section.settings.image.alt | default: 'The two of us, golden hour' -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '500, 1000', sizes: '(min-width: 861px) 40vw, 100vw', alt: meet_alt, loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'wl-couple.jpg' | asset_url }}" alt="The two of us, golden hour" width="900" height="1125" loading="lazy">
        {%- endif -%}
      </div>
      <div>
        <p class="wl-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="wl-h2">{{ section.settings.heading }} <span class="wl-k">{{ section.settings.heading_accent }}</span></h2>
        <p class="wl-p">{{ section.settings.p1 }}</p>
        <p class="wl-p"><b>{{ section.settings.p2_lead }}</b> {{ section.settings.p2 }}</p>
        {%- assign chips = section.settings.chips | split: '|' -%}
        <div class="wl-chips wl-band__chips">{%- for chip in chips -%}<span>{{ chip | strip }}</span>{%- endfor -%}</div>
        <p class="wl-p"><a class="wl-link" href="{{ section.settings.story_link | default: '/pages/story' }}">{{ section.settings.story_label }} &rarr;</a></p>
        <p class="wl-band__sig">&mdash; the Lipps</p>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .wl-meet-band { scroll-margin-top: 24px; }
{% endstylesheet %}

{% schema %}
{
  "name": "wetlipps · Meet the Lipps",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo (defaults to the beach photo)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Meet the Lipps" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chapped in paradise." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Not anymore." },
    { "type": "textarea", "id": "p1", "label": "Paragraph 1", "default": "We live outside — hiking, beach mornings, four kids in the sun, every day. Our lips pay for it, so we decided to start combating dry lips — one tube at a time." },
    { "type": "text", "id": "p2_lead", "label": "Paragraph 2 lead", "default": "And the name?" },
    { "type": "textarea", "id": "p2", "label": "Paragraph 2", "default": "Yes — we’re the Lipps family. It was right there the whole time. Fifteen years married, still flirting — this company is our date hike that got out of hand." },
    { "type": "text", "id": "chips", "label": "Chips (separate with |)", "default": "💍 Married 15 years | 🧒 Four kids | 🌊 Santa Barbara" },
    { "type": "text", "id": "story_label", "label": "Story link label", "default": "Read our story" },
    { "type": "url", "id": "story_link", "label": "Story link" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "wetlipps · Meet the Lipps", "category": "wetlipps" }]
}
{% endschema %}

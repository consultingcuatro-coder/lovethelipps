{%- comment -%}
  wetlipps head snippet — rendered from layout/theme.liquid right after color-palette.
  Loads the brand fonts and re-points Horizon's tokens so the cart drawer, search modal
  and any Horizon-rendered text inherit the wetlipps look. Shared wl-* classes live here
  because {% stylesheet %} blocks are subset per page and layouts cannot use them.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&display=swap">
{% style %}
  :root {
    --wl-cream: #F8F1E6; --wl-paper: #FFFDF8; --wl-rose: #ED8690; --wl-rosedeep: #CF5F69;
    --wl-petal: #EEACAC; --wl-kiss: #7A2530; --wl-blush: #EED2CC; --wl-water: #D8ECF4;
    --wl-ink: #241B18; --wl-black: #141010; --wl-gold: #C9A24B; --wl-goldlight: #7A5C1E;
    --wl-muted: #5d4c42; --wl-rule: rgba(122,37,48,.14);
    --font-heading--family: 'Young Serif', Georgia, serif;
    --font-heading--weight: 400;
    --font-accent--family: 'Young Serif', Georgia, serif;
    --font-accent--weight: 400;
    --font-body--family: 'Hanken Grotesk', system-ui, sans-serif;
    --font-subheading--family: 'Hanken Grotesk', system-ui, sans-serif;
  }
  body { font-size: 18px; line-height: 1.6; color: var(--wl-ink); }
  .wl-wrap { width: 100%; max-width: 1200px; margin: 0 auto; }
  .wl-eyebrow { font-size: 14px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: var(--wl-goldlight); margin: 0; }
  .wl-h1, .wl-h2, .wl-h3 { font-family: 'Young Serif', Georgia, serif; font-weight: 400; line-height: 1.06; color: var(--wl-ink); margin: 0; text-wrap: balance; }
  .wl-h2 { font-size: clamp(30px, 4vw, 46px); margin: 10px 0 8px; }
  .wl-h3 { font-size: 19px; }
  .wl-k { color: var(--wl-kiss); }
  .wl-cta, .wl-cta:hover { display: inline-block; background: var(--wl-kiss); color: var(--wl-cream); padding: 15px 34px; border-radius: 999px; font-weight: 700; font-size: 17px; text-decoration: none; border: none; cursor: pointer; font-family: inherit; line-height: 1.3; }
  .wl-cta2 { display: inline-block; margin-left: 14px; color: var(--wl-kiss); font-weight: 700; font-size: 17px; text-decoration: underline; text-decoration-color: currentColor; }
  .wl-chips { display: flex; gap: 14px; flex-wrap: wrap; }
  .wl-chips > * { background: var(--wl-paper); border: 1.5px solid rgba(122,37,48,.2); border-radius: 999px; padding: 9px 20px; font-size: 15px; font-weight: 600; color: var(--wl-ink); text-decoration: none; }
  .wl-card-surface { background: var(--wl-paper); border: 2px solid var(--wl-ink); border-radius: 18px; }
  .wl-section { padding-block: clamp(44px, 5.5vw, 76px); }
  .wl-section--tight { padding-block-start: 0; }
  .wl-p { font-size: 17.5px; margin: 12px 0 0; }
  .wl-p a, .wl-link { color: var(--wl-kiss); font-weight: 700; text-decoration: underline; text-decoration-color: currentColor; }
  /* Horizon-rendered buttons (add to cart) skinned to the wetlipps pill */
  .wl-add.button, .wl-cta.button { box-shadow: none; border-radius: 999px; font-family: inherit; font-weight: 700; display: inline-grid; }
  .wl-add.button { background: var(--wl-rose); color: #fff; font-size: 14.5px; padding: 8px 18px; min-height: 0; width: auto; }
  .wl-cta.button { background: var(--wl-kiss); color: var(--wl-cream); font-size: 17px; padding: 15px 34px; width: auto; }
  .wl-add.button:hover, .wl-cta.button:hover { filter: brightness(.95); color: inherit; }
  .wl-add.button .add-to-cart__added, .wl-cta.button .add-to-cart__added { color: inherit; }
  /* Two-column photo + copy band (homepage Meet the Lipps, story page What we believe) */
  .wl-band { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(28px, 5vw, 64px); align-items: center; background: var(--wl-paper); border: 2px solid var(--wl-ink); border-radius: 22px; padding: clamp(24px, 4vw, 50px); }
  .wl-band__img { min-width: 0; }
  .wl-band__img img { width: 100%; max-width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 18px; display: block; height: auto; }
  .wl-band__chips { margin-top: 14px; }
  .wl-band__sig { margin: 10px 0 0; font-family: 'Young Serif', Georgia, serif; font-size: 18px; color: var(--wl-kiss); }
  @media (max-width: 860px) { .wl-band { grid-template-columns: 1fr; } .wl-band__img img { max-width: 480px; margin: 0 auto; } }
  @media (max-width: 700px) { .wl-cta2 { margin-left: 0; display: block; margin-top: 12px; } }
{% endstyle %}
